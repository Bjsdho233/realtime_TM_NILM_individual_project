{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tm-nilm:development-data-manifest:1.0",
  "title": "Development-only data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "name",
    "created_at",
    "protocol_scope",
    "sealed_test_access",
    "candidate_or_locked_test_data_included",
    "entries"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/development-data-manifest.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "protocol_scope": {
      "const": "development_only"
    },
    "sealed_test_access": {
      "const": false
    },
    "candidate_or_locked_test_data_included": {
      "const": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path_or_locator",
          "content_sha256",
          "role",
          "fit_allowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path_or_locator": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "development_train",
              "development_validation",
              "read_only_reference"
            ]
          },
          "fit_allowed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
